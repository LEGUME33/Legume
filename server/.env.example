# 云端同步服务配置（复制为 .env 并修改）
# 生产环境务必修改 SECRET_KEY 为足够随机的长字符串
SECRET_KEY=change-me-to-a-random-long-string

# 监听地址与端口（免备案 IP 直连访问）
HOST=0.0.0.0
PORT=8000

# 允许的前端跨域来源，逗号分隔；* 表示全部放开（仅建议开发/内网使用，生产请限定前端域名）
CORS_ORIGINS=*

# JWT 有效期（小时），默认 365 天。前端会在启动 / 切前台 / 恢复网络时自动续期，
# 常用设备登录后近乎永久，无需反复重新登录。
TOKEN_EXPIRE_HOURS=8760

# SQLite 数据库文件路径（绝对路径或相对 server/ 目录）
DB_PATH=./legume.db
